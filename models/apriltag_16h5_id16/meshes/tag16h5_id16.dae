<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><contributor><authoring_tool>Generated AprilTag model</authoring_tool></contributor>
    <unit name="meter" meter="1"/><up_axis>Z_UP</up_axis></asset>
  <library_images><image id="tag_image" name="tag16h5_id16"><init_from>../materials/textures/tag16h5_id16.png</init_from></image></library_images>
  <library_effects><effect id="tag_effect"><profile_COMMON>
    <newparam sid="surface"><surface type="2D"><init_from>tag_image</init_from></surface></newparam>
    <newparam sid="sampler"><sampler2D><source>surface</source></sampler2D></newparam>
    <technique sid="common"><lambert><diffuse><texture texture="sampler" texcoord="UVSET0"/></diffuse></lambert></technique>
  </profile_COMMON></effect></library_effects>
  <library_materials><material id="tag_material" name="tag_material"><instance_effect url="#tag_effect"/></material></library_materials>
  <library_geometries><geometry id="tag_plane" name="tag_plane"><mesh>
    <source id="positions"><float_array id="positions_array" count="12">-0.05 -0.05 0  0.05 -0.05 0  0.05 0.05 0  -0.05 0.05 0</float_array>
      <technique_common><accessor source="#positions_array" count="4" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
    <source id="normals"><float_array id="normals_array" count="3">0 0 1</float_array>
      <technique_common><accessor source="#normals_array" count="1" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
    <source id="uvs"><float_array id="uvs_array" count="8">0 0  1 0  1 1  0 1</float_array>
      <technique_common><accessor source="#uvs_array" count="4" stride="2"><param name="S" type="float"/><param name="T" type="float"/></accessor></technique_common></source>
    <vertices id="vertices"><input semantic="POSITION" source="#positions"/></vertices>
    <triangles material="tag_material_symbol" count="2">
      <input semantic="VERTEX" source="#vertices" offset="0"/><input semantic="NORMAL" source="#normals" offset="1"/><input semantic="TEXCOORD" source="#uvs" offset="2" set="0"/>
      <p>0 0 0  1 0 1  2 0 2  0 0 0  2 0 2  3 0 3</p>
    </triangles>
  </mesh></geometry></library_geometries>
  <library_visual_scenes><visual_scene id="Scene" name="Scene">
    <node id="tag_node" name="tag_node"><instance_geometry url="#tag_plane">
      <bind_material><technique_common><instance_material symbol="tag_material_symbol" target="#tag_material"><bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD" input_set="0"/></instance_material></technique_common></bind_material>
    </instance_geometry></node>
  </visual_scene></library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
